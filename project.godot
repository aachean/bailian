[internationalization]

locale/fallback="zh_CN"
locale/translations=PackedStringArray("res://data/i18n/ui.zh_CN.translation", "res://data/i18n/ui.en.translation")

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="world"
2d_physics/layer_4="player_hitbox"
2d_physics/layer_5="enemy_hitbox"

[physics]

2d/default_gravity=1200.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.102, 0.106, 0.129, 1)
