; Engine configuration file.
; 建议用编辑器 UI 修改，手改容易漏掉联动项。
;
; 本文件的关键约定：
;   - 视口 640x360，按 canvas_items 拉伸到 1280x720 窗口（整数倍，像素不糊）
;   - 渲染后端选 GL Compatibility：2D 项目够用、启动快、兼容性好，日后好做网页版
;   - 贴图过滤设为 Nearest：为将来的像素美术准备
;   - 碰撞层命名见 [layer_names]，新增层时同步更新这里

config_version=5

[application]

config/name="百炼"
config/description="横版关卡制 ARPG：城镇整备 → 闯关打怪 → 打 Boss → 打造装备 → 变强 → 推进主线。"
run/main_scene="res://scenes/stages/test_room.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

