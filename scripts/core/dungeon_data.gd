class_name DungeonData
extends Resource
## 一个**副本**（Dungeon）：地图内可独立进入、可重复挑战的单元，由若干关卡顺序组成。
##
## 术语以 docs/CONTEXT.md 为准：地图 → 副本 → 关卡 三层，本类是第二层。
##
## ── 与旧结构的关系 ───────────────────────────────────────────
## 「副本」的前身就是线性时代的一关（`level_1/2/3.tscn`）—— 内容不重做，只重切：
## 把一条连续的路切成若干个一屏的关卡，摆进 stages。
##
## ── 副本的终点 ───────────────────────────────────────────────
## 通常是 Boss（砺场 = 磨刀石守卫、断淬渠 = 石甲卫），也允许是剧情节点
## （炉喉的终点是猎人的收尾对话，**不补第三个 Boss** —— 理由见 docs/adr/0009 §7：
## 补一个会稀释「石甲卫」作为第一章最强敌人的分量）。
## 终点是哪种不需要在这里声明：清空最后一关就是清完副本，
## Boss 只是最后一关里的一只怪。
##
## ── 空 stages 是有意义的 ──────────────────────────────────────
## 断淬渠 / 炉喉在「砺场竖向切片」阶段还没开工，stages 就是空的。
## 舆图会照实把它们标成「未开放」—— **不静默**：
## 玩家看到空列表会分不清是没做还是卡了（docs/design-conventions.md「不能静默的三件事」）。

@export_group("标识")
@export var id: StringName = &""
## 显示名的翻译 key（淬火岭下的三个副本：砺场 / 断淬渠 / 炉喉）
@export var name_key: StringName = &""

@export_group("关卡（按推进顺序）")
## 顺序即推进顺序：清空第 N 段解锁第 N+1 段，清空最后一段即清完本副本。
## 空数组 = 这个副本还没开工
@export var stages: Array[StageData] = []
