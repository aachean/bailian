class_name DungeonData
extends Resource
## 一个**副本**（Dungeon）：地图内可独立进入、可重复挑战的单元。**副本就是那个单元。**
##
## 术语以 docs/CONTEXT.md 为准：地图 → 副本 → 关卡 三层。
##
## ── 粒度：副本 = 一条 3~4 屏的路（2026-09-14 神反馈后**重定**）──────
## 第一版把副本切成「若干各自独立的一屏关卡」：进一次打一屏、清完弹舆图选下一屏。
## 神玩过之后的反馈是**不行**：
##   · 「一关一屏不够，点进出频繁」
##   · 「每段两只怪不够打」
## 改成造梦西游那种：**进副本 → 打完一屏 → 往右推进到下一屏 → … → 最后一屏出 Boss**，
## **整个副本打完才回舆图**。
##
## 于是「关卡」不再是可独立进入的单元 —— 副本才是。副本内部按**屏**推进，
## 而「屏」是关卡根节点在场景里按 x 分出来的段（`Screen1`/`Screen2`/…），
## **不是独立场景**。一屏的怪清空了才放行去下一屏：这是推进的节奏点，
## 也是「一次别把三四屏的怪全引到身上」的那个闸。
##
## ── 副本的终点 ───────────────────────────────────────────────
## 通常是 Boss（砺场 = 磨刀石守卫、断淬渠 = 石甲卫），也允许是剧情节点
## （炉喉的终点是猎人的收尾对话，**不补第三个 Boss** —— 理由见 docs/adr/0009 §7）。
## 不需要在这里声明是哪种：最后一屏清空就是清完副本，Boss 只是最后一屏里的怪。

@export_group("标识")
@export var id: StringName = &""
## 显示名的翻译 key（淬火岭下的三个副本：砺场 / 断淬渠 / 炉喉）
@export var name_key: StringName = &""

@export_group("场景")
## 副本场景：**一条横着铺开的多屏长路**，相机跟着玩家走。
## 关卡根节点的 `bounds` 要设成场景的实际宽度，否则相机到不了后半段
@export_file("*.tscn") var scene_path: String = ""
## 副本里有几屏。**给人看的信息**（HUD「第 2 屏 / 共 3 屏」、舆图上的「3 屏」）。
## 真正判定推进用的是场景里实际摆的屏分组（`Screen1`..`ScreenN`）——
## 两边对不上时以场景为准，但那样界面会显示错数字，所以有一条断言盯着它们相等
@export var screen_count: int = 3

@export_group("观感")
## 背景主题（assets/backgrounds/<名>/）：grass / stone / sand。空 = 不挂背景
@export var backdrop: StringName = &""

@export_group("门槛提示（只用来上色，不拦人）")
## 推荐等级 / 推荐武器强化等级。不够就在舆图上标红，**但绝不禁止进入**
## （docs/adr/0009 §5：硬门票会把「刷」变成义务）
@export var rec_level: int = 1
@export var rec_weapon: int = 0

@export_group("敌方强度")
## 本副本敌人的**攻击倍率**。1.0 = 表里那一章的锚点强度。
##
## ── 为什么需要这一格 ─────────────────────────────────────────
## `data/enemies/*.tres` 是**跨副本共用**的：同一只 walker 同时摆在砺场、
## 断淬渠、炉喉。而设计期的 `combat_defense.csv` **一行只锚定一章的一个等级**
## （ch1 锚在 lv20），ch1 却横跨 lv1（砺场）到 lv25（炉喉）——
## 拿 lv20 的 30 点去打 lv1 的玩家（100 血）就是四下一命。
##
## 倍率 = **该等级的玩家承受力 ÷ 章节锚点等级的承受力**，由
## `tools/apply_enemy_scaling.py` 从 `progression.tres` 的 hp 曲线算出后写进来。
## **别手改这里** —— 改曲线或改副本推荐等级都要重跑那个脚本。
##
## 只作用于**攻击**，不动血量：小怪血量是章内常量，那是 v1 已验收的手感
## （砺场 30 血 / 玩家 4 下打死）。让血量也随副本递增，砺场会变成「一刀一个」。
@export var enemy_atk_scale: float = 1.0


## 这个副本开工了没有（有没有场景可进）。
##
## **没开工的副本要在舆图上照实标出来**，不能留空行 ——
## 玩家看到「断淬渠」下面什么都没有，分不清是没做还是卡了
## （docs/design-conventions.md「不能静默的三件事」）
func is_ready() -> bool:
	return not scene_path.is_empty()

