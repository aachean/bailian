class_name StageData
extends Resource
## 一个**关卡**（Stage）：副本内的一个可独立进入的挑战，**约一屏，清空关内敌人即过关**。
##
## 术语以 docs/CONTEXT.md 为准：地图 → 副本 → 关卡 三层，本类是最下面那层。
##
## ── 关卡不取名，只编号 ────────────────────────────────────────
## 界面上写「第 2 段」（HUD 上是「第 2 段 / 共 3 段」），不给它起名字。
## 理由（docs/adr/0009 §6）：好名字要留给玩家会记住的东西 ——
## 他会记住「我在砺场」，不会记住「我在第 7 段」。
## 所以本类没有 name_key：只有 id（存档用）和它在副本里的位置（显示用）。
##
## ── 推荐值是软压力，不是门票 ──────────────────────────────────
## rec_level / rec_weapon 是入口给玩家的**一句可读的判断**：
## 「你这个等级 / 武器强化，进去可能会吃力」。不够就在舆图上标红，
## **但绝不禁止进入**（docs/adr/0009 §5）——
## 硬门票会把「刷」变成义务：玩家还没感到乐趣，就先感到「我得回去凑数」。
## 不新造「战力」这种数字 —— 一旦出现，玩家就会开始算它，而不是看自己的装备。

@export_group("标识")
## 存档里记的是「副本 id + 它在副本里的第几段」，关卡自己只认这个 id。
## 改 id 会让老存档对不上 —— 开发期可接受，写在这里备案
@export var id: StringName = &""

@export_group("场景")
## 一屏关卡，相机不动（关卡根节点的 bounds 设成与视口同大）
@export_file("*.tscn") var scene_path: String = ""

@export_group("门槛提示（只用来上色，不拦人）")
## 推荐等级 / 推荐武器强化等级
@export var rec_level: int = 1
@export var rec_weapon: int = 0
